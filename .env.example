# Export these variables in your shell; Django does not auto-load .env files.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Required for DEBUG=0; generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
# Optional locally; default is SQLite with one worker. Compose configures PostgreSQL.
# DATABASE_URL=postgresql://review:password@localhost:5432/review
# DB_SSLMODE=disable
# PRIVATE_STORAGE_ROOT=/absolute/path/to/private-data
# Optional: both are required to enable contextual AI review and discussion.
# Confirm provider terms and partner authorisation before sending documents.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
